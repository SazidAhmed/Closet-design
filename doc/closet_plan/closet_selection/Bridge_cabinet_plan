1. **In `loadCatalogCategories`**: We will ensure that when parsing the API response, if `cornerLeftCatalogs` and `cornerRightCatalogs` are separated in the API response, they are correctly mapped. Otherwise, they'll just fall back to filtering the `catalogs` list.
2. **In `resolveBridgeCatalogForCorner`**:
   ```typescript
   export function resolveBridgeCatalogForCorner(
     cornerPosition: 'left' | 'right',
     bridgeDepth: number,
     categoryCode: ClosetCatalogCategoryCode = 'CAS',
   ): ClosetCatalogEntry | null {
     try {
       const category = getCategoryByCode('without_doors', categoryCode);
       
       // Try to get them from the static separate arrays if they exist
       let list = cornerPosition === 'right'
         ? (category.cornerRightCatalogs ?? [])
         : (category.cornerLeftCatalogs ?? []);

       // If not in separate arrays, they might be in the main catalogs array (API response)
       if (!list || list.length === 0) {
         const prefix = cornerPosition === 'right' ? 'CRB' : 'CLB';
         list = category.catalogs.filter(c => c.code.startsWith(prefix));
       }

       if (!list || list.length === 0) return null;

       // Identify the catalog based on the bridge depth
       const matched = list.find((c) => bridgeDepth >= c.minD && bridgeDepth <= c.maxD);
       return matched ?? list.find((c) => bridgeDepth <= c.maxD) ?? list[list.length - 1] ?? null;
     } catch {
       return null;
     }
   }
   ```

3. **In `refreshBridgeCabinetForTower`**: Verify that the calculated `bridgeWidth` (`w`), `bridgeHeight` (`h`), and `bridgeDepth` (`d`) are correctly passed to `resolveBridgeCabinetForCorner`. (This seems to already be doing `Math.max(0, 23 - tower.depth)` for width, but we can verify it aligns perfectly with the spec).

